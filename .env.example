# Local development against `npm run db` (docker compose). In production these
# come from the container's environment; the names are unchanged from the
# Express API.
NODE_ENV=development
BDB_HOST=127.0.0.1
BDB_PORT=33316
BDB_DATABASE=banidb
BDB_USER=root
BDB_PASSWORD=root
MEILI_HOST=http://127.0.0.1:37700
MEILI_API_KEY=local-test-key-0123456789
# Optional: DB_POOL_SIZE (default 10), DB_NODES (JSON cluster: [{ "host", "port",
# "isPrimary" }]), SSL_CA (CA file path), PORT, TRUST_PROXY (default 1)
